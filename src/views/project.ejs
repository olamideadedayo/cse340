
<%- include('partials/header') %>

<h1><%= title %></h1>

<div class="project-tags">
    <div class="project-tags-header">
        <h3 style="margin: 0;">Categories:</h3>
        <a href="/project/<%= project.project_id %>/assign-categories" class="btn-submit" style="text-decoration: none; font-size: 0.85rem; padding: 0.4rem 0.8rem;">
            Edit Categories
        </a>
    </div>

    <% if (categories && categories.length > 0) { %>
        <div class="tags-container">
            <% categories.forEach(category => { %>
                <a href="/category/<%= category.category_id %>" class="category-tag">
                    <%= category.name %>
                </a>
            <% }) %>
        </div>
    <% } else { %>
        <p class="no-projects">No category tags assigned to this project.</p>
    <% } %>
</div>

<%- include('partials/footer') %>