<%- include('partials/header') %>

<h1><%= title %></h1>

<div class="volunteer-card">
    <% if (isLoggedIn) { %>
        <% if (isVolunteering) { %>
            <p class="volunteer-status-success">✓ You are volunteering for this project!</p>
            <p>Changed your mind? <a href="/projects/<%= project.project_id %>/leave" class="link-danger">Remove yourself as a volunteer</a></p>
        <% } else { %>
            <p>Interested in supporting this cause?</p>
            <a href="/projects/<%= project.project_id %>/volunteer" class="btn btn-primary">🙋 Volunteer for This Project</a>
        <% } %>
    <% } else { %>
        <p><em>Please <a href="/login" class="link-auth">log in</a> to sign up as a volunteer for this project.</em></p>
    <% } %>
</div>

<div class="project-tags">
    <div class="project-actions-header">
        <h3>Categories:</h3>
        
        <div class="project-actions-buttons">
            <a href="/edit-project/<%= project.project_id %>" class="btn-submit">
                Edit Project
            </a>
            
            <a href="/project/<%= project.project_id %>/assign-categories" class="btn-submit">
                Edit Categories
            </a>
        </div>
    </div>

    <% if (categories && categories.length > 0) { %>
        <div class="tags-container">
            <% categories.forEach(category => { %>
                <a href="/category/<%= category.category_id %>" class="category-tag">
                    <%= category.name %>
                </a>
            <% }) %>
        </div>
    <% } else { %>
        <p class="no-projects">No category tags assigned to this project.</p>
    <% } %>
    
    <% if (user && user.role_name === 'admin') { %>
        <div class="admin-controls">
            <a href="/edit-project/<%= project.project_id %>" class="btn">Edit Project Details</a>
            <a href="/project/<%= project.project_id %>/assign-categories" class="btn">Manage Categories</a>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>