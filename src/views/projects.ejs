<%- include('partials/header') %>

<h1><%= title %></h1>

<div class="projects-container">

    <% projects.forEach(project => { %>

        <div class="project-card">

            <h2>
                <a href="/project/<%= project.project_id %>">
                    <%= project.title %>
                </a>
            </h2>

            <p>
                Organization:

                <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>
            </p>

            <p>
                <strong>Date:</strong>
                <%= project.date %>
            </p>

            <p>
                <strong>Location:</strong>
                <%= project.location %>
            </p>

            <!-- ✅ ADDED LINK -->
            <p>
                <a href="/project/<%= project.project_id %>/assign-categories">
                    Assign Categories
                </a>
            </p>

        </div>

    <% }) %>

</div>

<div class="action-container">
    <p><a href="/new-project">Add a New Service Project</a></p>
</div>

<%- include('partials/footer') %>