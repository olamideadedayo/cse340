<%- include('partials/header') %>

<h1><%= title %></h1>

<div class="action-container" style="margin-bottom: 1.5rem;">
    <% if (typeof user !== 'undefined' && user && user.role_name === 'admin') { %>
        <a href="/new-project" class="btn">Add New Project</a>
    <% } %>
</div>

<div class="projects-container">
    <% projects.forEach(project => { %>
        <div class="project-card">
            <h2>
                <a href="/project/<%= project.project_id %>">
                    <%= project.title %>
                </a>
            </h2>

            <p>
                Organization:
                <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>
            </p>

            <p>
                <strong>Date:</strong>
                <%= project.date %>
            </p>

            <p>
                <strong>Location:</strong>
                <%= project.location %>
            </p>

            <% if (typeof user !== 'undefined' && user && user.role_name === 'admin') { %>
                <div class="admin-actions" style="margin-top: 1rem; border-top: 1px dashed #ccc; padding-top: 0.5rem;">
                    <a href="/edit-project/<%= project.project_id %>" class="btn btn-secondary" style="font-size: 0.85rem; margin-right: 5px;">Edit Project</a>
                    <a href="/project/<%= project.project_id %>/assign-categories" class="btn btn-secondary" style="font-size: 0.85rem;">Manage Categories</a>
                </div>
            <% } %>
        </div>
    <% }) %>
</div>

<%- include('partials/footer') %>
