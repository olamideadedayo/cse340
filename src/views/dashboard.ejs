<%- include('partials/header') %>
<main class="container management-container">
    <h1><%= title %></h1>

    <h2>Welcome Back!</h2>
    <div class="dashboard-profile">
        <p><strong>Name:</strong> <%= name %></p>
        <p><strong>Username/Email:</strong> <%= email %></p>
    </div>

    <div style="margin-top: 2.5rem;">
        <h2>Your Volunteered Service Projects</h2>
        
    <% if (locals.volunteeredProjects && volunteeredProjects.length > 0) { %>

            <ul class="projects-grid">
                <% volunteeredProjects.forEach(project => { %>
                    <li class="project-card">
                        <div>
                            <h2><a href="/project/<%= project.id %>"><%= project.title %></a></h2>
                            <p><%= project.description %></p>
                        </div>
                        <div class="admin-actions-footer">
                            <a href="/project/<%= project.id %>" class="btn-submit" style="text-decoration: none;">View Details</a>
                            <a href="/projects/<%= project.id %>/leave" class="btn-cancel volunteer-link-remove">
                                ❌ Leave Project
                            </a>
                        </div>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <div class="form-container volunteer-box">
                <p class="volunteer-text-auth">You haven't signed up for any volunteer projects yet.</p>
                <a href="/projects" class="btn-submit" style="text-decoration: none; display: inline-block; margin-top: 1rem;">
                    Browse Projects
                </a>
            </div>
        <% } %>
    </div>

    <% if (locals.user && locals.user.role_name === 'admin') { %>
        <div class="form-container" style="margin-top: 2.5rem; border-left: 5px solid var(--primary);">
            <h3 style="color: var(--dark); font-size: 1.25rem; margin-bottom: 0.5rem;">🛡️ Administrative Controls</h3>
            <p style="color: var(--muted); text-align: left; margin-bottom: 1rem;">
                Review registered system application profiles, audit authorization assignments, and manage roles.
            </p>
            <a href="/admin/users" class="add-organization" style="margin: 0; display: inline-block;">
                Manage Platform Users
            </a>
        </div>
    <% } %>
</main>
<%- include('partials/footer') %>
