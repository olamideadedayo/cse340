<%- include('partials/header') %>
<main>
  
    <h1><%= title %></h1>

    <h2><%= organization.name %></h2>
    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">

    <p>Description: <%= organization.description %></p>
    <p>Contact: <a href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a></p>

    <hr>
    
    <h3>Upcoming Projects</h3>
    <ul>
        <% if (projects && projects.length > 0) { %>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                </li>
            <% }) %>
        <% } else { %>
            <p>There are currently no upcoming projects scheduled for this organization.</p>
        <% } %>
    </ul>
    <div class="action-container">
    <a href="/edit-organization/<%= organization.organization_id %>" class="btn-action">
        Edit Organization Details
    </a>
    </div>
</main>
<%- include('partials/footer') %>
